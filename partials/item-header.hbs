<div class="item-header">
    {{#if title}}
    <div class="item-header-title">
        {{title}}
    </div>
    {{/if}}
    {{#if subtitle}}
    <div class="item-header-subtitle">
        {{#if description}}
        <span class="item-header-description">
            {{description}}
            <br/>
        </span>
        {{/if}}
        {{subtitle}}
    </div>
    {{/if}}
</div>
